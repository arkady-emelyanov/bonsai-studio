#!/usr/bin/env bash
# Shared configuration for the Bonsai 27B scripts.
# Source this; don't run it. Every value can be overridden from the environment.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_DIR="${BONSAI_SRC_DIR:-$ROOT/src/llama.cpp}"
BIN_DIR="${BONSAI_BIN_DIR:-$SRC_DIR/build/bin}"
MODEL_DIR="${BONSAI_MODEL_DIR:-$ROOT/models}"

# Which weight variant to run.
#   ternary -> Ternary-Bonsai-27B, Q2_0 group-64 (1.71 bpw, 7.6 GB) -- default, best quality
#   bonsai  -> Bonsai-27B, Q1_0 (1-bit, 3.5 GB) -- half the footprint, lower quality
#
# Note: Ternary Bonsai *2* (PTQ1_0/PQ2_0) is a different model and needs the
# PrismML llama.cpp fork; these scripts deliberately stick to the two variants
# that run on stock upstream llama.cpp.
BONSAI_FAMILY="${BONSAI_FAMILY:-ternary}"

case "$BONSAI_FAMILY" in
  ternary)
    HF_REPO="prism-ml/Ternary-Bonsai-27B-gguf"
    # The "-Q2_g64" file is the official upstream Q2_0 (group-64) packing.
    # The plain "-Q2_0.gguf" file in the same repo is the deprecated pre-migration
    # packing and is refused by current builds -- do not switch to it.
    MODEL_FILE="Ternary-Bonsai-27B-Q2_g64.gguf"
    MMPROJ_FILE="Ternary-Bonsai-27B-mmproj-Q8_0.gguf"
    ;;
  bonsai)
    HF_REPO="prism-ml/Bonsai-27B-gguf"
    MODEL_FILE="Bonsai-27B-Q1_0.gguf"
    MMPROJ_FILE="Bonsai-27B-mmproj-Q8_0.gguf"
    ;;
  *)
    echo "Unknown BONSAI_FAMILY '$BONSAI_FAMILY' (expected: ternary, bonsai)" >&2
    exit 1
    ;;
esac

MODEL_PATH="$MODEL_DIR/$MODEL_FILE"
MMPROJ_PATH="$MODEL_DIR/$MMPROJ_FILE"

# Profiles bundle the context/cache/vision settings that have to move together.
#
#   default -> 16K context, f16 cache, vision tower on the GPU. ~9 GB peak.
#   64k     -> 64K context, 4-bit cache, vision tower in system RAM. ~9.4 GB
#              peak. The comfortable long-context choice on a 12 GiB card: a
#              full GB of margin, and shorter prompt-processing waits.
#   100k    -> 100K context, otherwise identical to 64k. ~10.1 GB peak, which is
#              about the most a 12 GiB card can hold. The model is designed for a
#              4-bit KV cache (the card calls it near-lossless), so this is not
#              the compromise it would be on a normal model.
#   max     -> the full 262144-token window at 4-bit, ~12.8 GB peak. Needs a
#              16 GiB card, or BONSAI_KV_OFFLOAD=0 to park the cache in RAM.
#
# Anything set explicitly in the environment still wins over the profile.
case "${BONSAI_PROFILE:-default}" in
  default) _ctx=16384  ; _kv=f16  ; _mmproj_cpu=0 ;;
  64k)     _ctx=65536  ; _kv=q4_0 ; _mmproj_cpu=1 ;;
  100k)    _ctx=102400 ; _kv=q4_0 ; _mmproj_cpu=1 ;;
  max)     _ctx=262144 ; _kv=q4_0 ; _mmproj_cpu=1 ;;
  *) echo "Unknown BONSAI_PROFILE '$BONSAI_PROFILE' (expected: default, 64k, 100k, max)" >&2; exit 1 ;;
esac

# Context size. Only 16 of the 64 blocks use full attention (the rest are
# linear), so the cache grows slowly: published peaks are 8.4 GB at 4K, 8.7 GB
# at 10K and 14.7 GB at 100K, all with an f16 cache. A 4-bit cache cuts the
# context-dependent part of that roughly 4x.
BONSAI_CTX="${BONSAI_CTX:-$_ctx}"
BONSAI_KV_TYPE="${BONSAI_KV_TYPE:-$_kv}"
BONSAI_MMPROJ_CPU="${BONSAI_MMPROJ_CPU:-$_mmproj_cpu}"

# Layers to offload. 99 = everything; set 0 for CPU-only.
BONSAI_NGL="${BONSAI_NGL:-99}"

# Keep the KV cache on the GPU. Set 0 to hold it in system RAM instead -- the
# escape hatch when a long context is the only thing that does not fit. Decode
# gets substantially slower, since every token then crosses PCIe.
BONSAI_KV_OFFLOAD="${BONSAI_KV_OFFLOAD:-1}"
if [[ "$BONSAI_KV_OFFLOAD" == "0" ]]; then
  KV_OFFLOAD_ARGS=(--no-kv-offload)
else
  KV_OFFLOAD_ARGS=()
fi

# Sampling. The docs and the model card recommend slightly different values and
# each calls its own set "what the benchmarks used"; the docs' numbers are the
# tighter pair and are the default here. BONSAI_SAMPLING=card switches to the
# model card's.
if [[ "${BONSAI_SAMPLING:-docs}" == "card" ]]; then
  SAMPLING_ARGS=(--temp 0.7 --top-p 0.95 --top-k 20)
else
  SAMPLING_ARGS=(--temp 0.5 --top-p 0.85 --top-k 20 --min-p 0)
fi

# A quantized V cache requires flash attention; f16 leaves it on auto.
if [[ "$BONSAI_KV_TYPE" == "f16" ]]; then
  FLASH_ATTN_ARGS=(-fa auto)
else
  FLASH_ATTN_ARGS=(-fa on)
fi

# The vision tower only matters for image input. Keeping it in system RAM frees
# ~0.6 GiB of VRAM for KV cache at the cost of slower image prompts.
if [[ "$BONSAI_MMPROJ_CPU" == "1" ]]; then
  MMPROJ_ARGS=(--mmproj "$MMPROJ_PATH" --no-mmproj-offload)
else
  MMPROJ_ARGS=(--mmproj "$MMPROJ_PATH")
fi

COMMON_ARGS=(
  -m "$MODEL_PATH"
  "${MMPROJ_ARGS[@]}"          # vision tower; required for image input
  -c "$BONSAI_CTX"
  -ngl "$BONSAI_NGL"
  --cache-type-k "$BONSAI_KV_TYPE"
  --cache-type-v "$BONSAI_KV_TYPE"
  "${FLASH_ATTN_ARGS[@]}"
  "${KV_OFFLOAD_ARGS[@]}"
  --jinja                      # native OpenAI-style tool_calls
  "${SAMPLING_ARGS[@]}"
)

# Rough peak-VRAM estimate, from the published measurements: ~8.4 GB at 4K with
# an f16 cache, growing ~65 MB per additional 1K tokens, which a quantized cache
# scales down. Only a sanity check -- it exists to turn a confusing CUDA OOM
# halfway through loading into a warning before anything starts.
check_vram() {
  [[ "$BONSAI_NGL" == "0" ]] && return 0
  command -v nvidia-smi >/dev/null || return 0

  local free_mb
  free_mb=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1) || return 0

  local kv_divisor=1
  case "$BONSAI_KV_TYPE" in q8_0) kv_divisor=2 ;; q4_0|q4_1) kv_divisor=4 ;; esac

  local need_mb=$(( 8000 + (BONSAI_CTX - 4096) * 62 / 1000 / kv_divisor ))
  [[ "$BONSAI_MMPROJ_CPU" == "1" ]] || need_mb=$(( need_mb + 600 ))
  [[ "$BONSAI_KV_OFFLOAD" == "0" ]] && need_mb=8000

  if (( need_mb > free_mb )); then
    echo "!! Estimated peak ~${need_mb} MiB VRAM, but only ${free_mb} MiB is free." >&2
    echo "!! Try BONSAI_KV_TYPE=q4_0, BONSAI_MMPROJ_CPU=1, a smaller BONSAI_CTX," >&2
    echo "!! or BONSAI_KV_OFFLOAD=0 to hold the cache in system RAM." >&2
  fi
}

require_binary() {
  if [[ ! -x "$BIN_DIR/$1" ]]; then
    echo "Missing $BIN_DIR/$1 -- run scripts/00-build.sh first." >&2
    exit 1
  fi
}

require_model() {
  for f in "$MODEL_PATH" "$MMPROJ_PATH"; do
    if [[ ! -f "$f" ]]; then
      echo "Missing $f -- run scripts/01-download.sh first." >&2
      exit 1
    fi
  done
}
